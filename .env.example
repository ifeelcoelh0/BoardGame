# PeerJS signaling. Omitir para usar o serviço cloud padrão do PeerJS.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true
# VITE_PEER_KEY=peerjs
# VITE_PEER_DEBUG=0

# Lista JSON de servidores STUN/TURN. Nunca colocar credenciais permanentes num
# repositório público. Em produção, preferir credenciais TURN temporárias.
# Desenvolvimento/local pode funcionar apenas com STUN:
VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]


# TURN dinâmico (recomendado em produção). O browser chama este endpoint para
# receber credenciais temporárias. Estas variáveis VITE_* são públicas por
# natureza, por isso aqui só fica o caminho do endpoint — nunca o segredo.
# VITE_TURN_CREDENTIALS_ENDPOINT=/api/turn-credentials
# VITE_REQUIRE_TURN=true
# VITE_FORCE_TURN_RELAY=false  # usar true apenas num Preview para testar o relay

# Variáveis APENAS do servidor/Vercel Function. NÃO usar prefixo VITE_.
# Configura-as no dashboard da Vercel, não no repositório Git.
# CLOUDFLARE_TURN_KEY_ID=<id-da-turn-key>
# CLOUDFLARE_TURN_API_TOKEN=<token-secreto>
# TURN_CREDENTIAL_TTL_SECONDS=86400

# Endpoint opcional para diagnósticos. Sem esta variável, tudo fica no browser.
# VITE_DIAGNOSTICS_ENDPOINT=https://example.com/api/diagnostics
