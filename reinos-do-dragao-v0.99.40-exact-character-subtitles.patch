+export const CHARACTER_VOICE_TRANSCRIPTS = T;
+
+export function voiceTranscriptVariants(character, event) {
+  return T[character]?.[event] || Object.freeze([]);
+}
+
+export function voiceTranscript(character, event, variant = 1) {
+  const variants = voiceTranscriptVariants(character, event);
+  const index = Math.max(0, Number(variant || 1) - 1);
+  return variants[index] || variants[0] || "";
+}
